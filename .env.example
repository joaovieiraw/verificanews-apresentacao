PORT=3000
# O comando npm run local seleciona Gemini/Tavily e memória automaticamente.
# Alternativa configurável para npm start:
# PROVIDER=gemini-tavily
# STORAGE=memory
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# TAVILY_API_KEY=
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
DATABASE_URL=postgres://verificanews:troque-esta-senha@localhost:5432/verificanews
# Em produção, use certificado confiável; nunca desative a validação TLS.
DATABASE_SSL=false
OPENAI_API_KEY=
# Informe um modelo da sua conta que suporte Responses e Structured Outputs.
OPENAI_MODEL=
BRAVE_API_KEY=
RETENTION_DAYS=30
OCR_LANG=por+eng
# Lista editorial inicial; exige revisão humana contínua.
# Sem esta variável, usa src/source-policy.js. Descomente para substituir a lista inteira:
# TRUSTED_DOMAINS=gov.br,who.int,reuters.com,apnews.com,globo.com,uol.com.br,otempo.com.br,poder360.com.br
